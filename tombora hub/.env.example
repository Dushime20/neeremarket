# Seeded demo accounts (prisma db seed — local/dev only, never use in production)
# Admin:    admin@tomborahub.rw / Admin@Tombora1
# Customer: customer@demo.rw / Demo@Tombora1
# Sellers (password Demo@Tombora1):
#   seller@demo.rw  — Downtown Fashion Kigali
#   gadgets@demo.rw — Kigali Gadget Hub
#   beauty@demo.rw  — Nyamirambo Glow
#   harvest@demo.rw — Kimironko Harvest
#   living@demo.rw  — Gasabo Living
#   sport@demo.rw   — Amahoro Sports Kit
#   auto@demo.rw    — Kicukiro Auto Care
#   baby@demo.rw    — Gisozi Baby Nest
#   office@demo.rw  — Kacyiru Desk Lab

# Application
NODE_ENV=development
APP_NAME=NeereMarket
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
API_PREFIX=/api/v1
PORT=4000

# Database
POSTGRES_USER=tombora
POSTGRES_PASSWORD=tombora_dev_password
POSTGRES_DB=tombora_hub
DATABASE_URL=postgresql://tombora:tombora_dev_password@postgres:5432/tombora_hub?schema=public

# Redis
# Inside Docker Compose use: redis://redis:6379
# From host machine (mapped port): redis://127.0.0.1:6380
REDIS_URL=redis://redis:6379

# Auth (CHANGE IN PRODUCTION)
JWT_SECRET=change_me_access_secret_min_32_chars_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_dev
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# Business defaults (configurable; also stored in settings table)
COMMISSION_DEFAULT_RATE_BPS=1000
RETURN_WINDOW_DAYS=7
DEFAULT_CURRENCY=RWF

# Payments (abstraction — leave empty until provider credentials exist)
PAYMENT_PROVIDER=mock
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_CALLBACK_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_URL=

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email / SMS (optional in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tomborahub.rw
SMS_PROVIDER=mock

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# Authorized JavaScript origins: http://localhost:5173 (and your production origin)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME=NeereMarket
